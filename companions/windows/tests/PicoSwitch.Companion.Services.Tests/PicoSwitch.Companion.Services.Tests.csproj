<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Portable like the project under test, so the suite also runs on Linux CI. -->
    <TargetFramework>$(PicoSwitchPortableTargetFramework)</TargetFramework>
    <RootNamespace>PicoSwitch.Companion.Services.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>AnyCPU;x64;arm64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PicoSwitch.Companion.Services/PicoSwitch.Companion.Services.csproj" />
  </ItemGroup>

</Project>
