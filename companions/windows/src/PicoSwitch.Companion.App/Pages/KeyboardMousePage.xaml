<Page
    x:Class="PicoSwitch.Companion.App.Pages.KeyboardMousePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>


        <!-- Section headings inside a card. One style so every section starts at
             the same weight and the same distance from what precedes it. -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Page.Resources>

    <!--
      Three tabs so nothing needs scrolling (companion-shell-layout.md):

        Mapping   the keyboard and mouse buttons of the OPEN profile
        Mouse     mouse tuning, which belongs to the adapter, not to a profile
        Profiles  the library, the adapter's working set, switch keys, reset

      The header (mode) and the profile strip (which profile is open, Save /
      Discard) sit above the tabs because Mapping and Profiles both act on the
      open profile, and an unsaved edit must stay visible whichever tab is shown.
    -->
    <ScrollViewer x:Name="PageScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageGrid" Padding="32,12,32,32">
            <StackPanel x:Name="PageStack" MaxWidth="1240" HorizontalAlignment="Stretch" Spacing="12">

            <!-- Header: what the adapter is doing with keyboards, and the mode.
                 On a short window the tabs move into HeaderTabsSlot in place of
                 the title (ApplyShortWindow), as on Android and Linux. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderTabsSlot" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="PageTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Keyboard and mouse"
                        ToolTipService.ToolTip="Click a key to change it, middle-click to clear it." />
                    <StackPanel x:Name="ModeLine" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ModeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Not read yet"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ModeSeparator" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="·" />
                        <TextBlock x:Name="DevicesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="DisabledReason" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Section-scoped, never a window-wide overlay: the mouse
                         sliders are dragged and must stay usable. -->
                    <muxc:ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                    <ComboBox x:Name="ModeBox" AutomationProperties.Name="Mode"
                              ToolTipService.ToolTip="What the adapter does with a keyboard and mouse">
                        <ComboBoxItem Content="Automatic" />
                        <ComboBoxItem Content="Controller only" />
                        <ComboBoxItem Content="Keyboard" />
                        <ComboBoxItem Content="Keyboard and mouse" />
                    </ComboBox>
                    <Button x:Name="ModeApply" Content="Set" Click="OnSetMode" Style="{StaticResource CommandButtonStyle}" />
                    <Button x:Name="RefreshButton" Click="OnRefresh" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Reload" AutomationProperties.Name="Reload">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The page's non-Ready state, stated plainly.

                 There is deliberately no legacy editor behind this. When the
                 profile contract could not be loaded, the page used to fall
                 through to a pre-profile mapping grid, which looked like a
                 half-built feature rather than a failed read and cost a
                 hardware round trip to diagnose. One firmware contract, one
                 page: either it loaded, or this card says why it did not. -->
            <Border x:Name="NotReadyCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="NotReadyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="NotReadyDetail" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <Button x:Name="NotReadyRetry" Content="Reload" Click="OnRefresh"
                            Style="{StaticResource CommandButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <muxc:InfoBar x:Name="OperationBar" IsOpen="False" IsClosable="True" Severity="Error"
                          Title="Keyboard and mouse" />

            <StackPanel x:Name="Body" Spacing="12">

                <!-- One toolbar: the tabs on the left, the OPEN PROFILE on the
                     right. Selecting a profile OPENS it; it does not apply it: a
                     list selection must never change what the console is doing.
                     Save writes to the app's library and sends nothing to the
                     adapter; the adapter operations live on the Profiles tab,
                     where the user can see which position they act on. The
                     profile stays visible on every tab because Mapping and
                     Profiles both act on it, and an unsaved edit must not hide. -->
                <!-- On a short window the tabs leave for the header, the open
                     profile takes the left, and the Mapping actions the right
                     (ToolbarActionsSlot), so the keyboard keeps the height. -->
                <Grid x:Name="EditorCard" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ToolbarTabsSlot" VerticalAlignment="Center">
                    <SelectorBar x:Name="Tabs" VerticalAlignment="Center" SelectionChanged="OnTabChanged">
                        <SelectorBarItem x:Name="MappingTab" Text="Mapping" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE765;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="MouseTab" Text="Mouse">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE962;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ProfilesTab" Text="Profiles">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8F1;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    </Border>

                    <!-- Saved or not is said BY the Save button (SaveLabel), not a
                         status beside it: that cost the toolbar its one line on a
                         landscape handheld. -->
                    <StackPanel x:Name="ProfileRow" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <ComboBox x:Name="ProfileSelector" VerticalAlignment="Center"
                                  AutomationProperties.Name="Profile"
                                  ToolTipService.ToolTip="The profile you are editing"
                                  SelectionChanged="OnSelectedProfileChanged" />
                        <ComboBox x:Name="ProfileBox" VerticalAlignment="Center"
                                  AutomationProperties.Name="Layout"
                                  ToolTipService.ToolTip="Which layout this profile is for"
                                  SelectionChanged="OnProfileChanged">
                            <ComboBoxItem Content="Keyboard" />
                            <ComboBoxItem Content="Keyboard and mouse" />
                        </ComboBox>
                        <!-- Accent style is applied in code-behind, as it is for
                             a changed key: a Page.Resources style with BasedOn
                             on a framework theme style does not resolve at
                             markup-compile time. -->
                        <Button x:Name="SaveButton" Content="Save" Click="OnSaveProfile" Style="{StaticResource CommandButtonStyle}" VerticalAlignment="Center" />
                        <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscardProfile"
                                Style="{StaticResource CommandButtonStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="ToolbarActionsSlot" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>

                <!-- The state of the OPEN PROFILE. In a spacing-free panel:
                     a closed InfoBar still takes the parent's spacing. -->
                <StackPanel>
                    <muxc:InfoBar x:Name="DraftBar" IsOpen="False" IsClosable="False" Severity="Informational" />
                    <muxc:InfoBar x:Name="InactiveProfileBar" IsOpen="False" IsClosable="False" Severity="Warning"
                                  Title="Not the profile in use" />
                </StackPanel>

                <!-- MAPPING -->
                <Border x:Name="MappingPanel" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid x:Name="MappingHeader" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MappingSummary" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="CardActionsSlot" Grid.Column="1">
                            <StackPanel x:Name="MappingActions" Orientation="Horizontal" Spacing="8">
                                <!-- ISO and international keys are on few keyboards,
                                     so they are one click away. The toggle SWITCHES
                                     the card to them rather than stacking them under
                                     the keyboard (OnMoreKeysToggled). -->
                                <ToggleButton x:Name="MoreKeysToggle" Content="More keys"
                                              Checked="OnMoreKeysToggled" Unchecked="OnMoreKeysToggled"
                                              ToolTipService.ToolTip="ISO and international keys, and bound keys not drawn" />
                                <Button x:Name="ResetProfile" Content="Reset mapping"
                                        Click="OnResetProfile" Style="{StaticResource CommandButtonStyle}" />
                            </StackPanel>
                            </Border>
                        </Grid>

                        <!-- The keyboard itself. Built in code because the layout is
                             geometry, not markup. KeyboardBox scales it to the width
                             (and on a short window the height) it has, never below
                             MinKeyUnit a key; below that the scroller takes over so
                             a narrow window never scrolls the page sideways. -->
                        <ScrollViewer
                            x:Name="KeyboardScroller"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollMode="Disabled">
                            <Viewbox x:Name="KeyboardBox" Stretch="Uniform" HorizontalAlignment="Left">
                                <StackPanel x:Name="KeyboardHost" Orientation="Horizontal" Spacing="20" />
                            </Viewbox>
                        </ScrollViewer>

                        <!-- These three rows hold variable-length labels
                             ("Muhenkan", "Katakana/Hiragana"), so their buttons
                             size to their content instead of to a key-grid unit.
                             They are laid out with the same 8px rhythm as the
                             grid above rather than the 4px they used to use. -->
                        <StackPanel x:Name="OtherKeysSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="ISO and international keys" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Auto"
                                VerticalScrollMode="Disabled">
                                <StackPanel x:Name="OtherKeysHost" Orientation="Horizontal" Spacing="8" />
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel x:Name="UndrawnSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Keys not on this keyboard" />
                            <ItemsControl x:Name="UndrawnList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" Text="{Binding AccessibleName}" />
                                            <Button Grid.Column="1" Content="Change" Click="OnEditUndrawn"
                                                    Style="{StaticResource CommandButtonStyle}" Tag="{Binding Cap.Usage}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MOUSE. Tuning describes an analogue-stick emulation the user
                     cannot see, so it is the one place that earns explanatory
                     copy. Sliders, values and descriptions are built in code from
                     MouseSliders so the wording lives in the presentation layer. -->
                <!-- The button bindings beside the tuning, a third and two thirds
                     (LayMouse stacks them on a narrow window), and the tuning in
                     two columns of its own when it has the width (LayTuning). -->
                <Grid x:Name="MouseCard" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="MouseButtonsCard" Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="MouseButtonSection" Spacing="8">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Mouse buttons" />
                            <TextBlock x:Name="MouseButtonsNote" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Mouse buttons are mapped in the Keyboard and mouse layout." />
                            <VariableSizedWrapGrid x:Name="MouseButtonHost" Orientation="Horizontal" ItemWidth="112" ItemHeight="56" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TuningCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Mouse tuning" />
                            <Grid x:Name="TuningGrid" ColumnSpacing="28" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="FeelHost" Spacing="14" />
                                <StackPanel x:Name="DirectionHost" Grid.Column="1" Spacing="14" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- PROFILES.

                     Two columns on a wide window so the tab fits without
                     scrolling: what you have (library, adapter positions) on the
                     left, how you switch and reset on the right. LayProfiles
                     stacks them into one column on a narrow window. -->
                <Grid x:Name="ProfilesPanel" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- The library: the user's own collection, on this PC. -->
                    <tk:SettingsCard x:Name="LibraryCard" Header="Your profiles" Description="Saved on this PC. Choose which one to edit at the top.">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8F1;" /></tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NewButton" Content="New" Click="OnNewProfile" Style="{StaticResource CommandButtonStyle}" />
                            <Button x:Name="DuplicateButton" Content="Duplicate" Click="OnDuplicateProfile" Style="{StaticResource CommandButtonStyle}" />
                            <Button x:Name="RenameButton" Content="Rename" Click="OnRenameProfile" Style="{StaticResource CommandButtonStyle}" />
                            <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteProfile" Style="{StaticResource CommandButtonStyle}" />
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsCard x:Name="ResetCard" Grid.Column="1" Header="Reset everything"
                                     Description="Both layouts and mouse tuning go back to the adapter's defaults.">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE777;" /></tk:SettingsCard.HeaderIcon>
                        <Button x:Name="ResetAll" Content="Reset" Click="OnResetAll" Style="{StaticResource CommandButtonStyle}" />
                    </tk:SettingsCard>

                    <!-- ON ADAPTER.

                         The distinction the whole model turns on, made visible:
                         the library is the user's collection, this is the small
                         working set the adapter can use with nothing connected. A
                         position holds a COPY; editing the library profile does
                         not touch it, and only the buttons here send anything.
                         Rows are built in code because they are data, one per
                         position, empty ones included. -->
                    <Border x:Name="BankCard" Grid.Row="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="On the adapter" />
                                    <TextBlock x:Name="BankSummary" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="AssignButton" Content="Assign open profile"
                                        Click="OnAssignToAdapter" Style="{StaticResource CommandButtonStyle}" />
                            </Grid>
                            <StackPanel x:Name="BankHost" Spacing="6" />
                        </StackPanel>
                    </Border>

                    <!-- SWITCH KEYS.

                         One key per action, shared by both layouts: the key
                         selects "Profile 1", and which profile that is comes from
                         whichever layout is connected. That is why this sits
                         beside the bank rather than inside one of them. -->
                    <Border x:Name="SwitchCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Profile switch keys" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Text="Change profile without the app, in either layout." />
                            </StackPanel>
                            <StackPanel x:Name="SwitchHost" Spacing="6" />
                        </StackPanel>
                    </Border>

                    <muxc:Expander
                        x:Name="CountersExpander"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        IsExpanded="False"
                        Visibility="Collapsed"
                        Margin="0,4,0,0">
                        <muxc:Expander.Header>
                            <TextBlock
                                Text="Diagnostics: runtime counters"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </muxc:Expander.Header>
                        <TextBlock
                            x:Name="CountersText"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </muxc:Expander>

                </Grid>
            </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
