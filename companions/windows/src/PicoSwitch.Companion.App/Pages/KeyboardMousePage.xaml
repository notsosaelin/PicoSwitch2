<Page
    x:Class="PicoSwitch.Companion.App.Pages.KeyboardMousePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- One height and one minimum width for every command button on this
             page. Buttons were previously sized by their own text, so a row of
             them stepped in width and sat at three different baselines depending
             on whether the control beside them carried a Header. -->
        <Style x:Key="PageButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- Section headings inside a card. One style so every section starts at
             the same weight and the same distance from what precedes it. -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel MaxWidth="1240" HorizontalAlignment="Stretch" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Keyboard and mouse" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="Map a keyboard and mouse onto controller buttons. Click a key to change it, middle-click to clear it." />
            </StackPanel>

            <!-- The page's non-Ready state, stated plainly.

                 There is deliberately no legacy editor behind this. When the
                 profile contract could not be loaded, the page used to fall
                 through to a pre-profile mapping grid, which looked like a
                 half-built feature rather than a failed read and cost a
                 hardware round trip to diagnose. One firmware contract, one
                 page: either it loaded, or this card says why it did not. -->
            <Border x:Name="NotReadyCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="NotReadyTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="NotReadyDetail"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="NotReadyRetry"
                        Content="Reload"
                        Click="OnRefresh"
                        MinWidth="96"
                        Height="32"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <muxc:InfoBar
                x:Name="OperationBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Error"
                Title="Keyboard and mouse" />

            <StackPanel x:Name="Body" Spacing="16">

                <!-- Status and mode -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="ModeText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Not read yet" />
                                <TextBlock
                                    x:Name="DevicesText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Section-scoped, never a window-wide overlay: the mouse
                                 sliders below are dragged and must stay usable. -->
                            <muxc:ProgressRing
                                Grid.Column="1"
                                x:Name="BusyRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                VerticalAlignment="Top" />
                        </Grid>

                        <!-- Bottom-aligned so the combo box (which carries a
                             Header, and is therefore taller) and the buttons
                             share one baseline. -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ModeBox" Header="Mode" MinWidth="220" VerticalAlignment="Bottom">
                                <ComboBoxItem Content="Automatic" />
                                <ComboBoxItem Content="Controller only" />
                                <ComboBoxItem Content="Keyboard" />
                                <ComboBoxItem Content="Keyboard and mouse" />
                            </ComboBox>
                            <Button x:Name="ModeApply" Content="Set mode" Click="OnSetMode"
                                    Style="{StaticResource PageButtonStyle}" />
                            <Button x:Name="RefreshButton" Content="Reload" Click="OnRefresh"
                                    Style="{StaticResource PageButtonStyle}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="DisabledReason"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- The mapping grid. Shown ONLY in the Ready state. -->
                <Border x:Name="EditorCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">

                        <!-- Profiles.

                             Selecting a profile OPENS it. It does not apply it:
                             a list selection must never change what the console
                             is doing. Save writes to the adapter's library;
                             Set Active is what changes the console. Keeping
                             those two apart is the point of the whole row.

                             Two rows, not one. Six buttons plus two combo boxes
                             plus a status line on a single row could not fit
                             without squeezing, so the selectors sit above the
                             commands and the commands align right against them.
                             The profile controls come FIRST because choosing the
                             profile is the first thing a user does; the mapping
                             grid below is what they then edit. -->
                        <Grid x:Name="ProfileRow" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox
                                Grid.Row="0" Grid.Column="0"
                                x:Name="ProfileSelector"
                                MinWidth="220"
                                Header="Profile"
                                VerticalAlignment="Bottom"
                                SelectionChanged="OnSelectedProfileChanged" />

                            <ComboBox
                                Grid.Row="0" Grid.Column="1"
                                x:Name="ProfileBox"
                                MinWidth="200"
                                Header="Layout"
                                VerticalAlignment="Bottom"
                                SelectionChanged="OnProfileChanged">
                                <ComboBoxItem Content="Keyboard" />
                                <ComboBoxItem Content="Keyboard and mouse" />
                            </ComboBox>

                            <!-- Sits on the selectors' baseline rather than
                                 floating between them. -->
                            <TextBlock
                                Grid.Row="0" Grid.Column="2"
                                x:Name="ProfileStatus"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,6"
                                TextTrimming="CharacterEllipsis" />

                            <!-- LOCAL commands only. Save writes to the app's
                                 library and sends nothing to the adapter; the
                                 adapter operations live in the bank card below,
                                 where the user can see which position they act
                                 on. Keeping them apart is what stops "Save"
                                 from meaning "change what the console does". -->
                            <StackPanel
                                Grid.Row="1" Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,12,0,0">
                                <!-- Accent style is applied in code-behind, as it
                                     is for a changed key: a Page.Resources style
                                     with BasedOn on a framework theme style does
                                     not resolve at markup-compile time. -->
                                <Button x:Name="SaveButton" Content="Save" Click="OnSaveProfile"
                                        MinWidth="96" Height="32" VerticalAlignment="Bottom" />
                                <Button x:Name="DiscardButton" Content="Discard" Click="OnDiscardProfile"
                                        Style="{StaticResource PageButtonStyle}" />
                                <Border Width="1" Height="24" Margin="4,0" VerticalAlignment="Bottom"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button x:Name="NewButton" Content="New" Click="OnNewProfile"
                                        Style="{StaticResource PageButtonStyle}" />
                                <Button x:Name="DuplicateButton" Content="Duplicate" Click="OnDuplicateProfile"
                                        Style="{StaticResource PageButtonStyle}" />
                                <Button x:Name="RenameButton" Content="Rename" Click="OnRenameProfile"
                                        Style="{StaticResource PageButtonStyle}" />
                                <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteProfile"
                                        Style="{StaticResource PageButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Directly under the controls they describe. These
                             report the state of the OPEN PROFILE, so putting
                             them below the mapping heading separated a message
                             from the thing it was about. -->
                        <muxc:InfoBar
                            x:Name="DraftBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Informational" />

                        <muxc:InfoBar
                            x:Name="InactiveProfileBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning"
                            Title="Not the profile in use" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Key mapping" />
                                <TextBlock
                                    x:Name="MappingSummary"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ResetProfile" Content="Reset mapping"
                                    Click="OnResetProfile"
                                    Style="{StaticResource PageButtonStyle}" />
                        </Grid>

                        <!-- The keyboard itself. Built in code because the layout is
                             geometry, not markup. Scrolls in its own container so a
                             narrow window never scrolls the page sideways. -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollMode="Disabled">
                            <StackPanel x:Name="KeyboardHost" Orientation="Horizontal" Spacing="20" />
                        </ScrollViewer>

                        <!-- These three rows hold variable-length labels
                             ("Muhenkan", "Katakana/Hiragana"), so their buttons
                             size to their content instead of to a key-grid unit.
                             They are laid out with the same 8px rhythm as the
                             grid above rather than the 4px they used to use. -->
                        <StackPanel x:Name="OtherKeysSection" Spacing="6">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="ISO and international keys" />
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Auto"
                                VerticalScrollMode="Disabled">
                                <StackPanel x:Name="OtherKeysHost" Orientation="Horizontal" Spacing="8" />
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel x:Name="MouseButtonSection" Spacing="6">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Mouse buttons" />
                            <StackPanel x:Name="MouseButtonHost" Orientation="Horizontal" Spacing="8" />
                        </StackPanel>

                        <StackPanel x:Name="UndrawnSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Other bound keys" />
                            <ItemsControl x:Name="UndrawnList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" Text="{Binding AccessibleName}" />
                                            <Button Grid.Column="1" Content="Change" Click="OnEditUndrawn"
                                                    MinWidth="96" Height="32" Tag="{Binding Cap.Usage}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ON ADAPTER.

                     The distinction the whole model turns on, made visible: the
                     library above is the user's collection, this is the small
                     working set the adapter can use with nothing connected. A
                     position holds a COPY; editing the library profile does not
                     touch it, and only the buttons here send anything.

                     Rows are built in code because they are data — one per
                     position, empty ones included, since "Profile 3 — Empty" is
                     what tells a user they have somewhere to assign to. -->
                <Border x:Name="BankCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="On adapter" />
                                <TextBlock
                                    x:Name="BankSummary"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="AssignButton"
                                    Content="Assign to adapter" Click="OnAssignToAdapter"
                                    Style="{StaticResource PageButtonStyle}"
                                    MinWidth="150" />
                        </Grid>

                        <StackPanel x:Name="BankHost" Spacing="6" />

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- SWITCH KEYS.

                             One key per action, shared by both layouts: the key
                             selects "Profile 1", and which profile that is comes
                             from whichever layout is connected. That is why this
                             sits below the bank rather than inside one of them. -->
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="Profile switch keys" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="Change profile without the app. The same key works in both layouts and picks that layout's profile." />
                        </StackPanel>
                        <StackPanel x:Name="SwitchHost" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- Mouse tuning.

                     The one section on this page that earns explanatory copy: a
                     key with a controller button written on it explains itself,
                     but "smoothing window" and "anti-deadzone" describe an
                     analogue-stick emulation the user cannot see. Sliders, values
                     and descriptions are built in code from MouseSliders so the
                     wording lives in the presentation layer and is testable. -->
                <Border x:Name="MouseCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Mouse tuning" />
                        <StackPanel x:Name="SliderHost" Spacing="16" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="ToggleHost" Spacing="12" />
                    </StackPanel>
                </Border>

                <!-- Reset everything -->
                <Border x:Name="ResetCard" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Reset" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="Restores the adapter's defaults for both layouts and the mouse tuning." />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ResetAll" Content="Reset everything"
                                Click="OnResetAll" MinWidth="140" Height="32"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Diagnostics.

                     LAST on the page, outside the card system, collapsed, and in
                     secondary text. These counters are how a keyboard that
                     produces nothing at the console becomes visible at all, so
                     they stay reachable. They used to sit inside the status card
                     directly above the editing workflow, which gave a debugging
                     aid the same visual weight as choosing a profile. -->
                <muxc:Expander
                    x:Name="CountersExpander"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    IsExpanded="False"
                    Visibility="Collapsed"
                    Margin="0,4,0,0">
                    <muxc:Expander.Header>
                        <TextBlock
                            Text="Diagnostics: runtime counters"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </muxc:Expander.Header>
                    <TextBlock
                        x:Name="CountersText"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </muxc:Expander>
            </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
