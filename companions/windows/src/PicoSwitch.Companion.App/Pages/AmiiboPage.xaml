<Page
    x:Class="PicoSwitch.Companion.App.Pages.AmiiboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:pages="using:PicoSwitch.Companion.App.Pages"
    KeyDown="OnPageKeyDown">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PageButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- The inspector's two action rows must read as one control family.
             A Button and a ToggleButton do NOT share a corner radius by
             default, so Rename/Export/More looked square while
             Overview/Tag/Adapter looked like pills sitting directly beneath
             them. One height, one width, one radius for both. -->
        <Style x:Key="InspectorButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InspectorTabStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Grid tile. Artwork leads, then identity, then one small badge.
             Deliberately not a dump of every field: recognition is the job. -->
        <DataTemplate x:Key="GridTileTemplate" x:DataType="pages:AmiiboTile">
            <!-- Named for assistive technology. Without this a screen reader
                 announces the tile's type name, which tells a user nothing about
                 which Amiibo they are on. -->
            <Grid Width="152" Height="200" Padding="4"
                  AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Source="{x:Bind Image}" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE8EC;" FontSize="40" Opacity="0.3"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{x:Bind PlaceholderVisibility}" />

                <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10" Padding="7,2"
                        Visibility="{x:Bind BadgeVisibility}">
                    <TextBlock Text="{x:Bind Badge}" FontSize="10"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <!-- MEMBERSHIP OF THE BULK SET, which is not the same thing as
                     the highlight the host draws for focus. Not hit-testable:
                     the whole tile is the target, so there is no small box to
                     miss and no second thing to aim at.

                     An explicitly sized marker rather than a CheckBox. WinUI's
                     checkbox brings ~32pt of chrome and its own margins, and at
                     the top-left of a fixed-size tile the item container clipped
                     it — the top row of the grid showed no tick at all while
                     reporting the correct state to automation. A 20pt disc
                     cannot be clipped by a tile it fits inside, and it stays
                     legible over artwork of any colour. -->
                <Grid Width="20" Height="20" Margin="2"
                      VerticalAlignment="Top" HorizontalAlignment="Left"
                      IsHitTestVisible="False"
                      Visibility="{x:Bind TickVisibility, Mode=OneWay}">
                    <Ellipse Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                             Opacity="0.75" />
                    <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                             StrokeThickness="1" />
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                             Visibility="{x:Bind TickedVisibility, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="11"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              Visibility="{x:Bind TickedVisibility, Mode=OneWay}" />
                </Grid>

                <!-- Primary identity wraps to two lines; secondary truncates
                     first, so a long series never pushes the name out.

                     FIXED WIDTH, NOT STRETCHED. A GridViewItem insets its
                     content by a few points when it becomes selected, and a
                     caption sized to the container re-trimmed at that new width
                     — so "Link - Tears of the Kingdom" visibly re-flowed the
                     moment it was clicked. Pinning the width means the selection
                     visual cannot change where the ellipsis falls. -->
                <TextBlock Grid.Row="1" Text="{x:Bind Title}" MaxLines="2"
                           Width="140" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="16" FontSize="13"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Row="2" Text="{x:Bind Subtitle}" MaxLines="1"
                           Width="140" TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Carousel item. Large art, low density, almost no text: this mode is
             for unhurried browsing, not for reading metadata. -->
        <DataTemplate x:Key="CarouselTileTemplate" x:DataType="pages:AmiiboTile">
            <Grid Width="248" Height="316" Padding="8"
                  AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Source="{x:Bind Image}" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE8EC;" FontSize="72" Opacity="0.3"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{x:Bind PlaceholderVisibility}" />

                <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10" Padding="8,3"
                        Visibility="{x:Bind BadgeVisibility}">
                    <TextBlock Text="{x:Bind Badge}" FontSize="11"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <Grid Width="24" Height="24" Margin="4"
                      VerticalAlignment="Top" HorizontalAlignment="Left"
                      IsHitTestVisible="False"
                      Visibility="{x:Bind TickVisibility, Mode=OneWay}">
                    <Ellipse Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                             Opacity="0.75" />
                    <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                             StrokeThickness="1" />
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                             Visibility="{x:Bind TickedVisibility, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="13"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              Visibility="{x:Bind TickedVisibility, Mode=OneWay}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{x:Bind Title}" MaxLines="2"
                           Width="232" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Grid.Row="2" Text="{x:Bind Subtitle}" MaxLines="1"
                           Width="232" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- List row. The dense scanning mode: a thumbnail and aligned columns,
             materially shorter than a grid tile. -->
        <DataTemplate x:Key="ListRowTemplate" x:DataType="pages:AmiiboTile">
            <Grid Height="40" ColumnSpacing="12"
                  AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="2*" MinWidth="140" />
                    <ColumnDefinition Width="1.4*" MinWidth="110" />
                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="30" Height="30">
                    <Image Source="{x:Bind Image}" Stretch="Uniform" />
                    <FontIcon Glyph="&#xE8EC;" FontSize="14" Opacity="0.3"
                              Visibility="{x:Bind PlaceholderVisibility}" />

                    <!-- Over the thumbnail rather than in a new column: a column
                         that only exists in selection mode would shift every
                         other column sideways the moment a selection began. -->
                    <Grid Width="20" Height="20"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsHitTestVisible="False"
                      Visibility="{x:Bind TickVisibility, Mode=OneWay}">
                        <Ellipse Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                 Opacity="0.85" />
                        <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                 StrokeThickness="1" />
                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                 Visibility="{x:Bind TickedVisibility, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE73E;" FontSize="11"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  Visibility="{x:Bind TickedVisibility, Mode=OneWay}" />
                    </Grid>
                </Grid>

                <TextBlock Grid.Column="1" Text="{x:Bind Title}" MaxLines="1"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Series}" MaxLines="1"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Collection}" MaxLines="1"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Released}" MinWidth="84"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="{x:Bind FigureId}" MinWidth="140"
                           FontFamily="Consolas" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title, and the actions that belong to the LIBRARY rather than to any
             one Amiibo. Kept apart from the selected-item actions, which live
             with the selected item in the inspection pane. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Amiibo" />
                <TextBlock x:Name="LibrarySummary"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <!-- Only in the narrow layout, where the inspector is an
                     overlay and needs a way in. -->
                <!-- The discoverable and accessible routes to the two gestures.
                     A double click and a touch long press are both invisible
                     affordances, and neither exists for a keyboard or a screen
                     reader. -->
                <Button x:Name="DetailsButton" Style="{StaticResource PageButtonStyle}"
                        MinWidth="80" Content="Details"
                        AutomationProperties.Name="Open details for the focused Amiibo"
                        Click="OnShowDetails" />
                <Button x:Name="SelectButton" Style="{StaticResource PageButtonStyle}"
                        MinWidth="72" Content="Select"
                        AutomationProperties.Name="Start selecting Amiibo"
                        Click="OnStartSelection" />
                <Button x:Name="ImportButton" Style="{StaticResource PageButtonStyle}"
                        Content="Import…" Click="OnImport" />
                <Button x:Name="ImportFolderButton" Style="{StaticResource PageButtonStyle}"
                        Content="Import folder…" Click="OnImportFolder" />
                <Button x:Name="ExportArchiveButton" Style="{StaticResource PageButtonStyle}"
                        Content="Export all" Click="OnExportArchive" />

                <!-- Amiibo keys are APPLICATION configuration, not a property of
                     whichever figure happens to be selected. They used to sit at
                     the bottom of the inspector, which meant scrolling past one
                     Amiibo's details to manage global encryption keys. -->
                <Button x:Name="KeysButton" Style="{StaticResource PageButtonStyle}"
                        MinWidth="72" Content="Keys">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="8" Width="300">
                                <TextBlock Text="Amiibo keys"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="KeyStatus" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ImportKeysButton"
                                            Style="{StaticResource PageButtonStyle}"
                                            Content="Import keys" Click="OnImportKeys" />
                                    <Button x:Name="ForgetKeysButton"
                                            Style="{StaticResource PageButtonStyle}"
                                            Content="Forget" Click="OnForgetKeys" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <muxc:InfoBar x:Name="OperationBar" IsOpen="False" IsClosable="True" />
            <muxc:InfoBar x:Name="DirtyBar" IsOpen="False" IsClosable="False"
                          Severity="Warning"
                          Title="The console changed this Amiibo"
                          Message="The change exists only on the adapter. Sync it to your library before sending another tag or clearing this one." />
            <muxc:InfoBar x:Name="KeyBar" IsOpen="False" IsClosable="False"
                          Severity="Informational" />

            <!-- Search, then sort, then view. One row, in the order someone
                 reaches for them. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find"
                                PlaceholderText="Search name, character, series or ID"
                                TextChanged="OnSearchChanged" />

                <ComboBox Grid.Column="1" x:Name="SortBox" MinWidth="148"
                          Header="" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="Recently added" />
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Figure number" />
                    <ComboBoxItem Content="Release date" />
                </ComboBox>

                <Button Grid.Column="2" x:Name="SortDirectionButton"
                        Style="{StaticResource PageButtonStyle}" MinWidth="40"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE74A;"
                        AutomationProperties.Name="Reverse the order"
                        ToolTipService.ToolTip="Reverse the order"
                        Click="OnToggleSortDirection" />

                <!-- View mode. Presentation only: it never re-runs the query.
                     A ComboBox rather than a Segmented control, which this
                     Windows App SDK version does not ship. -->
                <ComboBox Grid.Column="3" x:Name="ViewSelector" MinWidth="128"
                          ToolTipService.ToolTip="How the library is shown"
                          SelectionChanged="OnViewModeChanged">
                    <ComboBoxItem Content="Grid" />
                    <ComboBoxItem Content="Carousel" />
                    <ComboBoxItem Content="Detailed list" />
                </ComboBox>
            </Grid>

            <!-- Filters, grouped as filters, with their own Clear. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="GameSeriesBox" HorizontalAlignment="Stretch"
                          PlaceholderText="Game series" SelectionChanged="OnFilterChanged" />
                <ComboBox Grid.Column="1" x:Name="AmiiboSeriesBox" HorizontalAlignment="Stretch"
                          PlaceholderText="Collection" SelectionChanged="OnFilterChanged" />
                <ComboBox Grid.Column="2" x:Name="TypeBox" HorizontalAlignment="Stretch"
                          PlaceholderText="Type" SelectionChanged="OnFilterChanged" />
                <Button Grid.Column="3" x:Name="ClearFiltersButton"
                        Style="{StaticResource PageButtonStyle}"
                        Content="Clear filters" Click="OnClearFilters" />
            </Grid>

            <!--
                THE BULK BAR. Present only while a selection exists, which is
                what makes selection mode unmistakable rather than something the
                user has to infer from tick marks.

                Two commands, deliberately. Multi-selection existing is not a
                reason to invent a dozen batch operations, and a crowded bar
                makes the destructive pair harder to aim at rather than easier.
            -->
            <!-- A card with an accent EDGE, not an accent fill. Filling it
                 accent put ordinary buttons on an accent ground, where their
                 translucent backgrounds read as disabled — the two commands the
                 bar exists for looked dead. The stripe marks the mode; the
                 buttons keep their normal contrast. -->
            <Border x:Name="SelectionBar" Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="4,0,0,0"
                    CornerRadius="4" Padding="12,6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionCount" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button Grid.Column="1" x:Name="BulkInitializeButton"
                            Style="{StaticResource PageButtonStyle}"
                            Content="Initialize…"
                            AutomationProperties.Name="Initialize the selected Amiibo"
                            Click="OnBulkInitialize" />
                    <Button Grid.Column="2" x:Name="BulkDeleteButton"
                            Style="{StaticResource PageButtonStyle}"
                            Content="Delete…"
                            AutomationProperties.Name="Delete the selected Amiibo"
                            Click="OnBulkDelete" />
                    <Button Grid.Column="3" Style="{StaticResource PageButtonStyle}"
                            MinWidth="36" Content="&#xE711;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            AutomationProperties.Name="Exit selection mode"
                            Click="OnCancelSelection" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Browse on the left, inspect on the right — when there is room for
             both. Below that the inspector overlays the browser instead of
             squeezing it off the screen; see OnContentSizeChanged. -->
        <Grid Grid.Row="2" x:Name="ContentArea" ColumnSpacing="12"
              SizeChanged="OnContentSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition x:Name="InspectorColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="8">
                <Grid>
                    <!-- THREE VIEWS, ONE ITEMS SOURCE. Each is collapsed rather
                         than unloaded, so switching view keeps selection and
                         costs no re-query. Only one is ever visible, so only one
                         realises containers. -->
                    <!--
                        SelectionMode stays Single in all three, including while
                        a bulk selection is being built. The host's own selection
                        draws FOCUS and nothing else; membership of the bulk set
                        is drawn by the tick in the item template.

                        Two ideas, two presentations. Handing the host a Multiple
                        selection mode instead would have conflated them again,
                        and switching SelectionMode at runtime re-realises the
                        containers — which is how the scroll position gets lost.
                    -->
                    <GridView x:Name="LibraryGrid" SelectionMode="Single"
                              IsItemClickEnabled="False"
                              ItemTemplate="{StaticResource GridTileTemplate}"
                              SelectionChanged="OnLibrarySelectionChanged"
                              Holding="OnLibraryHolding" />

                    <ListView x:Name="LibraryList" SelectionMode="Single" Visibility="Collapsed"
                              ItemTemplate="{StaticResource ListRowTemplate}"
                              SelectionChanged="OnLibrarySelectionChanged"
                              Holding="OnLibraryHolding">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!--
                        A GRIDVIEW, NOT A LISTVIEW, even though it lays out one
                        row. A ListView draws its selection as a pill on the
                        leading edge of the row, which in a horizontal panel
                        became a stray vertical line beside the tile instead of
                        marking it. GridView draws a border and tint around the
                        whole item, which is both correct here and identical to
                        the grid's — the same state should not look like two
                        different things in two views.

                        The horizontal scrollbar is hidden: it sat across the
                        bottom of a full-height browsing surface, and this view
                        is swiped or arrowed rather than dragged.
                    -->
                    <GridView x:Name="LibraryCarousel" SelectionMode="Single" Visibility="Collapsed"
                              IsItemClickEnabled="False"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center"
                              ItemTemplate="{StaticResource CarouselTileTemplate}"
                              SelectionChanged="OnLibrarySelectionChanged"
                              Holding="OnLibraryHolding">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Virtualising, and horizontal. A StackPanel here
                                     would build all 1000 large visual trees. -->
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <TextBlock x:Name="EmptyLibraryText" Visibility="Collapsed"
                               TextWrapping="Wrap" MaxWidth="420"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!--
                THE INSPECTOR. An inspector, not a settings page in a sidebar.

                Fixed regions on top — hero, primary action, secondary actions —
                then ONE small scrolling area holding whichever category is
                selected. Nothing important is ever below a long scroll, because
                only one category's rows are present at a time.
            -->
            <Border x:Name="Inspector" Grid.Column="1" Style="{StaticResource CardStyle}"
                    Width="420" Padding="14" HorizontalAlignment="Right">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Only in the narrow layout, where this panel covers the
                         browser and therefore needs a way out. -->
                    <Button x:Name="CloseInspectorButton" Grid.Row="0"
                            HorizontalAlignment="Right" Visibility="Collapsed"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            Height="28" MinWidth="28" Padding="0"
                            AutomationProperties.Name="Close details"
                            ToolTipService.ToolTip="Close details"
                            Click="OnCloseInspector" />

                    <StackPanel x:Name="SelectionEmpty" Grid.Row="1" Spacing="6">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Text="Nothing selected" />
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Pick an Amiibo to see its details and what you can do with it." />
                    </StackPanel>

                    <!-- COMPACT HERO. Horizontal, 64px art, three tight lines.
                         The old one burned ~120px of height before any metadata
                         began. -->
                    <Grid Grid.Row="1" x:Name="HeroPanel" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="64" Height="64" VerticalAlignment="Top">
                            <Image x:Name="SelectedArtwork" Stretch="Uniform" />
                            <FontIcon x:Name="SelectedArtworkPlaceholder" Glyph="&#xE8EC;"
                                      FontSize="26" Opacity="0.3" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedTitle" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="SelectedSubtitle" MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SelectedAdapterState" MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Primary action, immediately under the hero. -->
                    <StackPanel Grid.Row="2" x:Name="PrimaryActionPanel" Spacing="4"
                                Visibility="Collapsed">
                        <Button x:Name="SendButton" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Height="32"
                                Content="Send to adapter" Click="OnUpload" />
                        <TextBlock x:Name="SendReason" TextWrapping="Wrap" Visibility="Collapsed"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Ordinary actions inline; destructive ones behind More,
                         so they are one click away but never dominate. -->
                    <StackPanel Grid.Row="3" x:Name="SecondaryActionPanel"
                                Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="RenameButton" Style="{StaticResource InspectorButtonStyle}"
                                Content="Rename" Click="OnRename" />
                        <Button x:Name="ExportButton" Style="{StaticResource InspectorButtonStyle}"
                                Content="Export" Click="OnExportOne" />
                        <Button x:Name="MoreButton" Style="{StaticResource InspectorButtonStyle}"
                                Content="More">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="InitializeItem" Text="Initialize…"
                                                    Click="OnInitialize" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="DeleteItem" Text="Delete…"
                                                    Click="OnDelete" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- CATEGORIES, not one giant scroll. -->
                    <!-- Separated from the action row above: these switch what
                         you are LOOKING at, where those act on the Amiibo. Two
                         adjacent rows of identical buttons read as one control
                         group, which is exactly what they are not. -->
                    <StackPanel Grid.Row="4" x:Name="CategoryBar" Orientation="Horizontal"
                                Spacing="8" Margin="0,10,0,2" Visibility="Collapsed">
                        <ToggleButton x:Name="OverviewTab" Content="Overview"
                                      Style="{StaticResource InspectorTabStyle}"
                                      Click="OnCategoryChanged" />
                        <ToggleButton x:Name="TagTab" Content="Tag"
                                      Style="{StaticResource InspectorTabStyle}"
                                      Click="OnCategoryChanged" />
                        <ToggleButton x:Name="AdapterTab" Content="Adapter"
                                      Style="{StaticResource InspectorTabStyle}"
                                      Click="OnCategoryChanged" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- Overview and Tag are dense label/value grids. -->
                            <StackPanel x:Name="DetailHost" Spacing="2" />

                            <!-- The adapter category. Its deeper controls only
                                 appear when they can actually be used; five dead
                                 buttons teach nobody anything. -->
                            <StackPanel x:Name="AdapterPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="SlotHeadline"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Text="Not read yet" />
                                <TextBlock x:Name="SlotDetail" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <muxc:ProgressBar x:Name="TransferProgress" Visibility="Collapsed"
                                                  Minimum="0" Maximum="100" />
                                <TextBlock x:Name="TransferLabel" Visibility="Collapsed"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel x:Name="AdapterControls" Spacing="8"
                                            Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="PresentButton" Style="{StaticResource PageButtonStyle}"
                                                MinWidth="84" Content="Present" Click="OnPresent" />
                                        <Button x:Name="EjectButton" Style="{StaticResource PageButtonStyle}"
                                                MinWidth="84" Content="Eject" Click="OnEject" />
                                        <Button x:Name="CancelButton" Style="{StaticResource PageButtonStyle}"
                                                MinWidth="84" Content="Cancel"
                                                Click="OnCancelTransfer" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SyncButton" Style="{StaticResource PageButtonStyle}"
                                                MinWidth="120" Content="Sync to library" Click="OnSync" />
                                        <Button x:Name="ClearButton" Style="{StaticResource PageButtonStyle}"
                                                MinWidth="84" Content="Clear" Click="OnClear" />
                                    </StackPanel>

                                    <StackPanel x:Name="CopySection" Spacing="6" Visibility="Collapsed">
                                        <TextBlock x:Name="CopyLabel"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="UseOriginalButton" Style="{StaticResource PageButtonStyle}"
                                                    MinWidth="110" Content="Use original" Click="OnUseOriginal" />
                                            <Button x:Name="UseConsoleCopyButton" Style="{StaticResource PageButtonStyle}"
                                                    MinWidth="110" Content="Console copy" Click="OnUseConsoleCopy" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="RefreshButton" Style="{StaticResource PageButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Content="Reload adapter state" Click="OnRefresh" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
