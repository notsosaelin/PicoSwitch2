<Page
    x:Class="PicoSwitch.Companion.App.Pages.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Play: the home screen (docs/architecture/companion-shell-layout.md, "Play"),
      laid out like a console home screen. The tiles are built in
      ControllerPage.xaml.cs (the same structure as Linux's PlayPage and
      Android's PlayScreen); this file holds the theme-aware styles they wear,
      so a theme switch repaints them.
    -->
    <Page.Resources>
        <Style x:Key="PlayTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- News on a tile: the headset LIVE, a game waiting for an amiibo. -->
        <Style x:Key="PlayTileLit" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="PlayHero" TargetType="Border" BasedOn="{StaticResource PlayTile}">
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="PlayHeroLit" TargetType="Border" BasedOn="{StaticResource PlayTileLit}">
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="Circle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CircleLit" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Every action on Play: 52 tall, radius 14, one size, told apart by colour only. -->
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="ActionAccent" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="ActionDanger" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- A whole tile that is one button: transparent, so the tile's own colour shows in every state. -->
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        x:Name="Scroller"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Border x:Name="PageFill" HorizontalAlignment="Center" />
    </ScrollViewer>
</Page>
