<Page
    x:Class="PicoSwitch.Companion.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <!--
      This app's own preferences. The adapter and its controllers are managed on
      the Adapter page (companion-shell-layout.md).
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,12,32,32">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12" Text="Settings" />

            <tk:SettingsCard Header="Theme">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" Style="{StaticResource CardSelectorStyle}" automation:AutomationProperties.Name="Theme" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Use system setting" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </tk:SettingsCard>

            <!-- Where the slide-out navigation comes in from (companion-shell-layout.md, "Navigation"). -->
            <tk:SettingsCard Header="Navigation" Description="Where the menu slides in from. Automatic: the side of a wide window, the bottom of a tall one.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE700;" />
                </tk:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="NavigationBox"
                    Style="{StaticResource CardSelectorStyle}"
                    automation:AutomationProperties.Name="Navigation"
                    SelectionChanged="OnNavigationChanged" />
            </tk:SettingsCard>

            <!--
                Which console button a face button sends. Automatic is right for
                almost everyone, so this lives here rather than on Play.
            -->
            <tk:SettingsCard Header="Face buttons">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7FC;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="FaceLayoutReason" TextWrapping="Wrap" />
                </tk:SettingsCard.Description>
                <ComboBox
                    x:Name="FaceLayoutBox"
                    Style="{StaticResource CardSelectorStyle}"
                    automation:AutomationProperties.Name="Face buttons"
                    SelectionChanged="OnFaceLayoutChanged" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Header="Diagnostics"
                Description="Log, Bluetooth bonds and support bundle"
                IsClickEnabled="True"
                Click="OnOpenDiagnostics">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
