<Page
    x:Class="PicoSwitch.Companion.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="32,12,32,24">
        <Grid MaxWidth="1000" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Diagnostics" />
                    <!-- The ring is bounded; the summary always states what was dropped. -->
                    <TextBlock
                        x:Name="Summary"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Content="Copy support bundle"
                        Click="OnCopyBundle"
                        Style="{StaticResource AccentCommandButtonStyle}"
                        ToolTipService.ToolTip="The log plus Windows and radio details. Bluetooth addresses are shortened; adapter nicknames are left out." />
                    <Button Style="{StaticResource CommandButtonStyle}" Content="Copy log" Click="OnCopy" />
                    <Button Style="{StaticResource CommandButtonStyle}" Content="Clear" Click="OnClear" />
                </StackPanel>
            </Grid>

            <muxc:InfoBar
                Grid.Row="1"
                x:Name="OperationBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Title="Diagnostics" />

            <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8">
                <!-- Low-level LE bonds. Diagnostics only; never Paired Controllers. -->
                <tk:SettingsExpander
                    Header="Bluetooth bond slots"
                    Description="The adapter's raw LE credentials, for support. Controllers are managed in Settings.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE702;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <Button x:Name="BondsRefresh" Style="{StaticResource CommandButtonStyle}" Content="Read" Click="OnReadBonds" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <TextBlock
                                x:Name="BondsText"
                                FontFamily="Consolas"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap"
                                Text="Not read." />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- The management gate. Destructive and one-way from the app's side. -->
                <tk:SettingsExpander
                    Header="Management over Bluetooth"
                    Description="Turning this off ends this session and every future one. The app cannot turn it back on, because it would need this very channel to do it.">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="GateState" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Unknown" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Turn off permanently">
                            <Button x:Name="GateDisable" Style="{StaticResource CommandButtonStyle}" Content="Turn off" Click="OnDisableGate" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>

            <!-- Wide content scrolls inside its own container; the window body never
                 scrolls horizontally. -->
            <Border
                Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer
                    x:Name="LogScroller"
                    Padding="12,8"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="LogText"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
