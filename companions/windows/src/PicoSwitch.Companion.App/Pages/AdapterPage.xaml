<Page
    x:Class="PicoSwitch.Companion.App.Pages.AdapterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <!--
      Laid out as Windows 11 Settings is: a compact header, then SettingsCard
      rows in one column capped at the width Settings itself uses. Each row is
      a name on the left and its control on the right; the reason a control is
      unavailable is the row's description, shown only when there is one.
    -->
    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,24,0,6" />
        </Style>
        <Style x:Key="Reason" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageGrid" Padding="32,12,32,32"><StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">

            <!--
              Header: which adapter, its firmware, and the actions on it. No state
              words: the title bar is the app's one connection indicator, and the
              same words a few pixels under it read as two notifications.
            -->
            <!-- On a short window the tabs join this row (HeaderTabsSlot) and the
                 adapter's name, which the title bar already shows, is dropped. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="12" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderTabsSlot" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="AdapterTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="No adapter" />
                        <muxc:ProgressRing
                            x:Name="BusyRing"
                            automation:AutomationProperties.Name="Working"
                            Width="16"
                            Height="16"
                            IsActive="False" />
                    </StackPanel>
                    <TextBlock x:Name="FirmwareText" Style="{StaticResource Reason}" Visibility="Collapsed" />
                    <TextBlock x:Name="PhaseDetail" Style="{StaticResource Reason}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="Connect" Click="OnConnect" Style="{StaticResource AccentCommandButtonStyle}" />
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnect" Style="{StaticResource CommandButtonStyle}" />
                    <Button
                        x:Name="RefreshButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnRefresh"
                        ToolTipService.ToolTip="Refresh"
                        automation:AutomationProperties.Name="Refresh">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Radio problems, probed rather than assumed. Hidden when healthy. -->
            <muxc:InfoBar x:Name="RadioBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="Bluetooth" />

            <!--
                The bridge-contract verdict. Its visibility IS the silence rule:
                Pending must never render, because it is a transient state on every
                healthy connection.
            -->
            <muxc:InfoBar x:Name="ContractBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="Firmware compatibility" />

            <muxc:InfoBar x:Name="OperationBar" IsOpen="False" IsClosable="True" Severity="Error" Title="Adapter" />

            <!--
                Three tabs, so the page fits without scrolling
                (companion-shell-layout.md): what the adapter does for the
                console, the controllers paired to it, and the adapters this
                device remembers. Opens on "Adapters" when none is remembered,
                because adding one is then the only useful thing to do.
            -->
            <Border x:Name="PageTabsSlot">
            <SelectorBar x:Name="Tabs" Margin="0,8,0,4" SelectionChanged="OnTabChanged">
                <SelectorBarItem Text="Console" IsSelected="True">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE7F4;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="Controllers">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE7FC;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="Adapters">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE702;" /></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            </Border>

            <StackPanel x:Name="ConsolePanel" Spacing="4">

            <tk:SettingsCard Header="Controller on the console">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7FC;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="BatteryText" Visibility="Collapsed" />
                </tk:SettingsCard.Description>
                <TextBlock x:Name="ControllerText" Text="No controller" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Emulated controller">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7FC;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="PersonalityReason" Visibility="Collapsed" />
                </tk:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        x:Name="PersonalityBox" Style="{StaticResource CardSelectorStyle}"
                        automation:AutomationProperties.Name="Emulated controller"
                        ToolTipService.ToolTip="The console briefly loses the controller while it switches." />
                    <Button x:Name="PersonalityApply" Content="Switch" Style="{StaticResource CommandButtonStyle}" Click="OnSwitchPersonality" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Input source">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8AB;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="InputReason" Visibility="Collapsed" />
                </tk:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        x:Name="InputBox" Style="{StaticResource CardSelectorStyle}"
                        automation:AutomationProperties.Name="Input source"
                        ToolTipService.ToolTip="Exactly one source drives the console at a time." />
                    <Button x:Name="InputApply" Content="Use" Style="{StaticResource CommandButtonStyle}" Click="OnSetInput" />
                </StackPanel>
            </tk:SettingsCard>
            <muxc:InfoBar
                x:Name="InputTruncated"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                Title="Some sources were not listed"
                Message="The adapter reported more input sources than fit in one reply." />

            </StackPanel>

            <!-- Controllers the adapter itself has paired. -->
            <StackPanel x:Name="ControllersPanel" Spacing="4" Visibility="Collapsed">
            <tk:SettingsCard Header="Pair a controller">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7FC;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="PairControllerReason" TextWrapping="Wrap" Visibility="Collapsed" />
                </tk:SettingsCard.Description>
                <Button x:Name="PairControllerButton" Content="Pair" Style="{StaticResource CommandButtonStyle}" Click="OnPairController" />
            </tk:SettingsCard>

            <muxc:InfoBar
                x:Name="PeersUnsupported"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                Title="Controller list unavailable" />

            <StackPanel x:Name="PeerSections" Spacing="4">
                <StackPanel x:Name="ConnectedSection" Spacing="4">
                    <TextBlock Style="{StaticResource Reason}" Margin="1,8,0,0" Text="Connected" />
                    <ItemsControl x:Name="ConnectedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <tk:SettingsCard Margin="0,0,0,4" Header="{Binding Title}" Description="{Binding Detail}">
                                    <Button Style="{StaticResource CommandButtonStyle}" Content="Forget" automation:AutomationProperties.Name="{Binding ForgetLabel}" Click="OnForgetPeer" Tag="{Binding PeerId}" IsEnabled="{Binding CanForget}" />
                                </tk:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="PairedSection" Spacing="4">
                    <TextBlock Style="{StaticResource Reason}" Margin="1,8,0,0" Text="Paired" />
                    <ItemsControl x:Name="PairedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <tk:SettingsCard Margin="0,0,0,4" Header="{Binding Title}" Description="{Binding Detail}">
                                    <Button Style="{StaticResource CommandButtonStyle}" Content="Forget" automation:AutomationProperties.Name="{Binding ForgetLabel}" Click="OnForgetPeer" Tag="{Binding PeerId}" IsEnabled="{Binding CanForget}" />
                                </tk:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Spacing="4">
                    <TextBlock
                        Style="{StaticResource Reason}"
                        Margin="1,8,0,0"
                        Text="Recent"
                        ToolTipService.ToolTip="Seen before, but no longer paired with the adapter." />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <tk:SettingsCard Margin="0,0,0,4" Header="{Binding Title}" Description="{Binding Detail}">
                                    <Button Style="{StaticResource CommandButtonStyle}" Content="Remove" automation:AutomationProperties.Name="{Binding RemoveFromHistoryLabel}" Click="OnRemoveHistory" Tag="{Binding PeerId}" />
                                </tk:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock
                    x:Name="PeersEmpty"
                    Style="{StaticResource Reason}"
                    Margin="1,4,0,0"
                    Text="Connect an adapter to see its controllers." />
            </StackPanel>

            </StackPanel>

            <!-- Remembered adapters: this device's relationships with adapters. -->
            <StackPanel x:Name="AdaptersPanel" Spacing="4" Visibility="Collapsed">
            <tk:SettingsCard Header="Add an adapter">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE702;" />
                </tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="PairingHint" TextWrapping="Wrap" Text="Double-tap the adapter's pairing button first." />
                </tk:SettingsCard.Description>
                <Button x:Name="PairButton" Content="Add" Click="OnPair" Style="{StaticResource AccentCommandButtonStyle}" />
            </tk:SettingsCard>

            <ItemsControl x:Name="AdapterList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <tk:SettingsCard Margin="0,0,0,4" Header="{Binding Title}">
                            <tk:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock Text="{Binding StateText}" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </tk:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource CommandButtonStyle}" Content="Connect" automation:AutomationProperties.Name="{Binding ConnectLabel}" Click="OnConnectRow" Tag="{Binding Address}" IsEnabled="{Binding CanConnect}" />
                                <Button Style="{StaticResource CommandButtonStyle}" Content="Rename" automation:AutomationProperties.Name="{Binding RenameLabel}" Click="OnRenameRow" Tag="{Binding Address}" />
                                <Button Style="{StaticResource CommandButtonStyle}" Content="Repair" automation:AutomationProperties.Name="{Binding RepairLabel}" Click="OnRepairRow" Tag="{Binding Address}" ToolTipService.ToolTip="Pair again from scratch" />
                                <Button Style="{StaticResource CommandButtonStyle}" Content="Remove" automation:AutomationProperties.Name="{Binding RemoveLabel}" Click="OnRemoveRow" Tag="{Binding Address}" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            </StackPanel>
        </StackPanel></Grid>
    </ScrollViewer>
</Page>
