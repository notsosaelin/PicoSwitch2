<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      THE APP'S SIZE SCALE (docs/architecture/companion-shell-layout.md, "Sizes").

      Every page used to pick its own button height (28, 32, 36, 40, 44) and its
      own minimum widths, so a row of controls from two pages never lined up.
      Three heights, chosen once, and nothing in a page sets a control height
      except through these:

        ControlHeight       36  every button, dropdown, toggle and text box
        LargeControlHeight  44  Play's secondary actions and card actions
        HeroControlHeight   76  Play's one primary action (Start / Stop)

      Widths follow the same rule: a command button is at least CommandMinWidth
      wide, a dropdown at least SelectorMinWidth, so a short label ("Set") is
      not a stub next to a long one ("Assign open profile").

      Applied as IMPLICIT styles below, so a control that says nothing gets the
      standard. Explicit sizes remain only where the size IS the content: the
      drawn keyboard's keys, swatches, the dock.
    -->
    <x:Double x:Key="ControlHeight">36</x:Double>
    <x:Double x:Key="LargeControlHeight">44</x:Double>
    <x:Double x:Key="HeroControlHeight">76</x:Double>
    <x:Double x:Key="CommandMinWidth">96</x:Double>
    <x:Double x:Key="SelectorMinWidth">220</x:Double>
    <x:Double x:Key="PageMaxWidth">1000</x:Double>
    <x:Double x:Key="WidePageMaxWidth">1240</x:Double>
    <Thickness x:Key="PagePadding">32,12,32,24</Thickness>

    <!-- No MinWidth on plain Button: the drawn keyboard's keys are Buttons,
         and icon buttons are square. CommandButtonStyle carries the width. -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    </Style>
    <!-- NO implicit DropDownButton style. One BasedOn DefaultDropDownButtonStyle
         compiled cleanly and then failed every page holding a DropDownButton
         at load with "XAML parsing failed" (found 2026-11-06 on Amiibo). A
         DropDownButton takes MinHeight="{StaticResource ControlHeight}" where
         it is declared instead. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource SelectorMinWidth}" />
    </Style>
    <!-- A dropdown that is a settings card's control. The toolkit's SettingsCard
         restyles its content, so the implicit ComboBox style above does not
         reach it (measured 32 epx, at whatever width its longest item gave it).
         One fixed width lines the right-hand edge of every card up. -->
    <x:Double x:Key="CardSelectorWidth">280</x:Double>
    <Style x:Key="CardSelectorStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Width" Value="{StaticResource CardSelectorWidth}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    </Style>

    <!-- A labelled command ("Connect", "Save", "Reset"). -->
    <Style x:Key="CommandButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource CommandMinWidth}" />
    </Style>
    <Style x:Key="AccentCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource CommandMinWidth}" />
    </Style>

    <!-- An icon-only button (refresh, keys): square at the control height. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Play's secondary actions and the status cards' action. -->
    <Style x:Key="LargeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="{StaticResource LargeControlHeight}" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="18,0" />
    </Style>
    <!-- The same footprint for a Play secondary action that has an on/off state
         (the Headset toggle). -->
    <Style x:Key="LargeToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Height" Value="{StaticResource LargeControlHeight}" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="18,0" />
    </Style>
    <Style x:Key="LargeAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="{StaticResource LargeControlHeight}" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="18,0" />
    </Style>
</ResourceDictionary>
