# Source and documentation are text; retain repository LF normalization.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ndjson text eol=lf
*.csv text eol=lf
*.kt text eol=lf

# Windows companion (C#/WinUI). LF in the repository like every other source
# tree here; MSBuild, Roslyn and the XAML compiler are all indifferent to it.
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.xaml text eol=lf
*.appxmanifest text eol=lf
*.manifest text eol=lf
*.sln text eol=crlf

# Linux companion packaging. Executed by /bin/sh and read by desktop shells on
# Linux, where a CRLF checkout breaks the shebang (`/bin/sh^M`). Forced to LF so
# an AppImage built from a Windows checkout (core.autocrlf=true) still runs.
*.sh text eol=lf
*.desktop text eol=lf
companions/linux/packaging/AppRun text eol=lf

# Captures, firmware, executables, recordings, and raw image planes are binary
# evidence. Never pass them through line-ending or textual diff filters.
*.bin binary
*.uf2 binary
*.exe binary
*.pcap binary
*.pcapng binary
*.gz binary
*.m4a binary
*.mp4 binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.gray binary
