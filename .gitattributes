# Source and documentation are text; retain repository LF normalization.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.ndjson text eol=lf

# Captures, firmware, executables, recordings, and raw image planes are binary
# evidence. Never pass them through line-ending or textual diff filters.
*.bin binary
*.uf2 binary
*.exe binary
*.pcap binary
*.pcapng binary
*.gz binary
*.m4a binary
*.mp4 binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.gray binary
