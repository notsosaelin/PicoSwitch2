<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral management core. Kotlin counterpart: `:management-core`.

    `net9.0`, and no ProjectReference to PicoSwitch.Bridge.Core. Management and
    Controller Link are two INDEPENDENT relationships with the same adapter
    (WINDOWS_PASS.md §3.4); the Kotlin modules keep them apart and so does this.
  -->
  <PropertyGroup>
    <TargetFramework>$(PicoSwitchPortableTargetFramework)</TargetFramework>
    <RootNamespace>PicoSwitch.Management</RootNamespace>
    <AssemblyName>PicoSwitch.Management.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PicoSwitch.Management.Core.Tests" />
  </ItemGroup>

  <!--
    The firmware's canonical KB/M default mappings, embedded.

    A companion must be able to create and edit a profile with NO adapter
    connected: the library belongs to the user, not to a device. A local profile
    stores only sparse overrides, so drawing one needs the table those overrides
    are applied against — and that table is firmware data.

    Generated by tools/test_ns2_kbm_commands.c and linked (not copied) from
    tools/fixtures, so there is one authority. A parity test asserts the embedded
    copy still matches what the firmware emits.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../../../tools/fixtures/management/kbm-default-mappings.json"
                      LogicalName="PicoSwitch.Management.KbmDefaultMappings.json" />
  </ItemGroup>

</Project>
