<Window
    x:Class="PicoSwitch.Companion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Mica reaches the top edge because the title bar is extended into the
        client area. The drag region MUST be declared explicitly (the Grid named
        AppTitleBar below, passed to SetTitleBar) or the window becomes
        unmovable - a standard WinUI 3 trap, called out in WINDOWS_PASS.md 17.2.
    -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <TextBlock
                x:Name="AppTitleTextBlock"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="PicoSwitch2 Companion" />
        </Grid>

        <!--
            Destinations keep the Android set and order: Adapter, Keyboard &amp;
            Mouse, Amiibo, Gamepad, Settings. Diagnostics is reached FROM
            Settings and is deliberately not a daily destination.

            Full titles in the rail rather than the phone's truncated labels: a
            NavigationView has the room, and re-truncating them in the name of
            parity would be a regression.
        -->
        <muxc:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Adapter" Tag="adapter">
                    <muxc:NavigationViewItem.Icon>
                        <!-- The Symbol enum has no Bluetooth member; E702 is the system glyph. -->
                        <FontIcon Glyph="&#xE702;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Keyboard &amp; Mouse" Tag="kbm">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Keyboard" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Amiibo" Tag="amiibo">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Tag" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Gamepad" Tag="gamepad">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    The connection banner is global because connection state
                    affects every page. Absent when the session is Ready; carries
                    the primary recovery action for the current phase.
                -->
                <muxc:InfoBar
                    x:Name="ConnectionBanner"
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Adapter" />

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </muxc:NavigationView>

        <!--
            The Touch Gamepad is a MODE, not a destination (WINDOWS_PASS.md §15.4):
            it owns its whole presentation and is entered and left explicitly.

            It covers row 1 only. That hides the navigation chrome, which is the
            point, while leaving the extended title bar - and therefore the window's
            only drag region - reachable. An overlay across row 0 as well would make
            the window unmovable for as long as the surface was open.
        -->
        <Grid
            x:Name="TouchGamepadHost"
            Grid.Row="1"
            Visibility="Collapsed" />
    </Grid>
</Window>
