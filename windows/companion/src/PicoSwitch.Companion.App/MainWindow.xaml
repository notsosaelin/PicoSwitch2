<Window
    x:Class="PicoSwitch.Companion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Mica reaches the top edge because the title bar is extended into the
        client area. The drag region MUST be declared explicitly (the Grid named
        AppTitleBar below, passed to SetTitleBar) or the window becomes
        unmovable - a standard WinUI 3 trap, called out in WINDOWS_PASS.md 17.2.
    -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Named because the Touch Gamepad paints it. See ApplyTouchTitleBar: the
        controller's ground goes on the WHOLE window, not on the caption strip
        alone, because the strip's height is not the only thing that can be left
        unpainted at a given display scale.
    -->
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <TextBlock
                x:Name="AppTitleTextBlock"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="PicoSwitch2 Companion" />
        </Grid>

        <!--
            Destinations keep the Android set and order: Adapter, Keyboard &amp;
            Mouse, Amiibo, Gamepad, Settings. Diagnostics is reached FROM
            Settings and is deliberately not a daily destination.

            Full titles in the rail rather than the phone's truncated labels: a
            NavigationView has the room, and re-truncating them in the name of
            parity would be a regression.
        -->
        <muxc:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Adapter" Tag="adapter">
                    <muxc:NavigationViewItem.Icon>
                        <!-- The Symbol enum has no Bluetooth member; E702 is the system glyph. -->
                        <FontIcon Glyph="&#xE702;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Keyboard &amp; Mouse" Tag="kbm">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Keyboard" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Amiibo" Tag="amiibo">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Tag" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Gamepad" Tag="gamepad">
                    <muxc:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    The connection banner is global because connection state
                    affects every page. Absent when the session is Ready; carries
                    the primary recovery action for the current phase.
                -->
                <muxc:InfoBar
                    x:Name="ConnectionBanner"
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Adapter" />

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </muxc:NavigationView>

        <!--
            The Touch Gamepad is a MODE, not a destination (WINDOWS_PASS.md §15.4),
            and it REPLACES the shell rather than covering it: ShowTouchGamepad
            collapses the NavigationView above, empties the title strip and drops
            the window's Mica backdrop. This is the Windows form of the Android
            companion's early return, where the scaffold is simply never composed.

            It occupies row 1, which is the whole client area once the title strip
            is reduced to the caption band. Row 0 keeps that band because an
            extended title bar is the window's only drag region, and a windowed
            controller that cannot be moved is not finished.

            Do NOT give this host a translucent background or restore an overlay
            arrangement here. The first version layered the surface over a live
            NavigationView, and the rail, cards and status bars showed through the
            controller.
        -->
        <Grid
            x:Name="TouchGamepadHost"
            Grid.Row="1"
            Visibility="Collapsed" />
    </Grid>
</Window>
