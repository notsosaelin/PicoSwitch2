<Page
    x:Class="PicoSwitch.Companion.App.Pages.AmiiboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Amiibo" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="The local library, and the tag the adapter is presenting." />
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                Text="Phase 5 fills this page: import, upload with progress, present/eject, save slots, and CRC-verified download. The management session it needs is built." />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
