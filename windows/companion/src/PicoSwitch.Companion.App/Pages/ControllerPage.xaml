<Page
    x:Class="PicoSwitch.Companion.App.Pages.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Horizontal scrolling OFF. A ScrollViewer that allows it measures its content
      with unbounded width, so `TextWrapping="Wrap"` never engages and the
      explanation is clipped by the window edge instead of wrapping into it. This
      page is almost entirely prose, and prose the user cannot read explains
      nothing.
    -->
    <ScrollViewer
        Padding="24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Spacing="8">

                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Gamepad" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="This PC as a controller source for the adapter." />

                <!--
                  Every string below comes from ControllerLinkView, which is unit
                  tested. Nothing here decides what to say: a sentence written in
                  markup cannot be asserted, and §33.2 accepts a negative §14.5
                  result only if the UI explains the limitation SPECIFICALLY.
                -->
                <Border
                    Margin="0,20,0,0"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Name="Headline"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="Explanation"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="StartButton" Click="OnStart" Content="Start Controller Link" />
                            <Button x:Name="StopButton" Click="OnStop" Content="Stop" />
                            <ProgressRing
                                x:Name="Busy"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                  Which controller on this PC feeds the adapter.

                  Deliberately here and not on the Adapter page: that page's
                  "Console input source" is the ADAPTER choosing among its own
                  sources, which is a different decision about different hardware.

                  Every string below comes from ControllerSourceView, which is
                  unit tested, for the same reason as the card above.
                -->
                <Border
                    Margin="0,20,0,0"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="Controller on this PC" />
                        <TextBlock
                            x:Name="SourceHeadline"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SourceDetail"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="SourceChooser"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                            <ComboBox
                                x:Name="SourceBox"
                                MinWidth="320"
                                AutomationProperties.Name="Controller on this PC" />
                            <Button
                                x:Name="SourceApply"
                                Click="OnUseSource"
                                Content="Use this controller" />
                        </StackPanel>
                        <Button
                            x:Name="SourceRefresh"
                            Click="OnRefreshSources"
                            Content="Look again" />
                    </StackPanel>
                </Border>

                <!--
                  Phase 6a is NOT gated on the §14.5 outcome (WINDOWS_PASS.md §31),
                  so this says so plainly rather than leaving a user to conclude the
                  whole page is dead - and it is reachable from here whatever the
                  radio turned out to be capable of.
                -->
                <Border
                    Margin="0,20,0,0"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="On-screen controller" />
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="Lay out a touch controller for whichever controller the adapter is emulating, and use it as a Controller Link input source." />
                        <Button Click="OnOpenTouchGamepad" Content="Open the on-screen controller" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
