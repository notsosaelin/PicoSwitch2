<UserControl
    x:Class="PicoSwitch.Companion.App.Touch.TouchGamepadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The on-screen controller, as a DEDICATED SCREEN.

      This is the Windows counterpart of the Android surface, and the structure is
      deliberately the same one: `CompanionApp.kt` returns early when the Touch
      Gamepad is active, so the scaffold, the navigation rail and the content column
      are never composed at all, and `TouchGamepadScreen` paints an opaque
      `Box(...).background(Color.Black)` that owns the whole display.

      The Windows equivalent lives half here and half in MainWindow: the shell's
      title bar and NavigationView are collapsed, the window's Mica backdrop is
      removed, and this control paints an opaque ground of its own.

      THE RULE THIS FILE EXISTS TO KEEP: the root below carries an explicit opaque
      Background. The previous version set `Background` on the UserControl instead
      and left the root Grid unpainted, which paints nothing — so over a Mica
      window the companion's rail, cards and status bars showed straight through
      the controller. Do not move that brush back onto the UserControl, and do not
      replace it with a Layer, Acrylic, Mica or otherwise translucent brush.
    -->
    <!--
      The ground the controller is drawn on: near-black, in BOTH host themes.

      Android paints Color.Black here unconditionally, and the controller's own
      colours are fixed artwork tokens rather than theme brushes (see
      TouchControlRenderer.Palette). A theme-following ground would put those
      fixed colours on white in light mode, where the outline disappears and the
      near-black button faces become the loudest thing on the display.

      Still explicitly OPAQUE, which is the rule the comment above exists for.
    -->
    <Grid x:Name="Root" Background="{StaticResource TouchSurfaceGroundBrush}">

        <!--
          The interaction-safe rectangle is built from THIS element's size, and it is
          the same rectangle the layout is resolved into. Nothing ever takes space
          from it: the editor's chrome floats OVER the controller and can be moved,
          exactly as on Android, because layout editing is a spatial task and a
          docked panel forces the user to map widgets onto a layout they cannot see.
        -->
        <Grid x:Name="SurfaceHost" SizeChanged="OnSurfaceSizeChanged">
            <!--
              The canvas is a tab stop and handles its own keys, which is what makes
              the editor operable with no pointer at all (§26.5). Tab moves BETWEEN
              controls only while the canvas holds focus, and Escape hands focus back
              on the way out, so keyboard navigation is never trapped in the layout.
            -->
            <Canvas x:Name="Surface" Background="Transparent"
                    AutomationProperties.Name="Controller layout"
                    IsTabStop="True"
                    KeyDown="OnSurfaceKeyDown"
                    RightTapped="OnSurfaceRightTapped"
                    PointerPressed="OnSurfacePressed"
                    PointerMoved="OnSurfaceMoved"
                    PointerReleased="OnSurfaceReleased"
                    PointerCaptureLost="OnSurfaceCaptureLost" />

            <!--
              Play mode's ONLY chrome, and the answer to "how do I get out of this".

              Android needs no such button because the system Back gesture opens its
              menu. Windows has no equivalent gesture on a touchscreen in a desktop
              app, so one small, low-contrast target sits in the corner of the safe
              region. Right-clicking the surface and the context-menu key do the same
              thing.
            -->
            <Button x:Name="MenuButton"
                    Click="OnOpenMenu"
                    Content="&#xE700;"
                    FontFamily="Segoe Fluent Icons"
                    AutomationProperties.Name="Touch Gamepad menu"
                    ToolTipService.ToolTip="Touch Gamepad menu"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.55"
                    Width="40"
                    Height="40" />

            <!--
              The link status, in the layout's quiet centre band.

              Same place and same shape as the Android surface's link banner: the band
              is kept clear by the layout itself, so a status there shadows nothing the
              user is trying to press, and it takes no height away from the controller.
            -->
            <Border x:Name="LinkPill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    CornerRadius="16"
                    Padding="16,7"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                <TextBlock x:Name="LinkPillText"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>

            <!--
              Shown INSTEAD of the controller when the window genuinely cannot hold it.
              Drawing an overlapping controller would be worse than refusing: the user
              would press one control and the console would receive another.
            -->
            <Border x:Name="UnusableNotice"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Padding="24"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="UnusableText"
                               TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <Button Click="OnClose" Content="Leave the Touch Gamepad"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--
              The editor's floating, dockable toolbar. Present only in edit mode, and
              positioned by TouchToolbarLayout rather than by markup.

              Every glyph-only control carries an AutomationProperties.Name. A ToolTip
              is not a name: without one a screen reader announces "button" and the
              whole toolbar becomes unusable, which a sighted keyboard pass would never
              notice.
            -->
            <Canvas x:Name="ToolbarLayer" Visibility="Collapsed">
                <Border
                    x:Name="Toolbar"
                    Padding="6"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    SizeChanged="OnToolbarSizeChanged">
                    <StackPanel x:Name="ToolbarItems" Orientation="Horizontal" Spacing="4">
                        <Border
                            x:Name="ToolbarHandle"
                            AutomationProperties.Name="Move the toolbar"
                            Width="18"
                            Background="Transparent"
                            PointerPressed="OnToolbarPressed"
                            PointerMoved="OnToolbarMoved"
                            PointerReleased="OnToolbarReleased"
                            PointerCaptureLost="OnToolbarReleased">
                            <TextBlock
                                Text="&#xE76F;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Button x:Name="AddButton" Content="&#xE710;"
                                AutomationProperties.Name="Add a control"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Add a control">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AddMenu" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="DuplicateButton" Click="OnDuplicate" Content="&#xE8C8;"
                                AutomationProperties.Name="Duplicate"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Duplicate" />
                        <Button x:Name="GroupButton" Click="OnGroupOrUngroup" Content="&#xF16E;"
                                AutomationProperties.Name="Group"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Group (Ctrl+G)" />
                        <Button x:Name="DeleteButton" Click="OnDelete" Content="&#xE74D;"
                                AutomationProperties.Name="Remove"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Remove (Delete)" />
                        <Button x:Name="UndoButton" Click="OnUndo" Content="&#xE7A7;"
                                AutomationProperties.Name="Undo"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Undo (Ctrl+Z)" />
                        <Button x:Name="RedoButton" Click="OnRedo" Content="&#xE7A6;"
                                AutomationProperties.Name="Redo"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Redo (Ctrl+Y)" />

                        <!--
                          The toolbar's one menu. Everything that would otherwise need a
                          second, permanent contextual strip lives in here, headed by the
                          name of the control it acts on — which is also the only place
                          that name has to be, because the selection outline on the canvas
                          already says WHICH control.
                        -->
                        <Button x:Name="MoreButton" Content="&#xE712;"
                                AutomationProperties.Name="More"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="More">
                            <Button.Flyout>
                                <MenuFlyout x:Name="MoreMenu">
                                    <MenuFlyoutItem x:Name="SelectionHeader" IsEnabled="False" />
                                    <MenuFlyoutItem x:Name="SmallerItem" Text="Smaller"
                                                    Click="OnSmaller" />
                                    <MenuFlyoutItem x:Name="LargerItem" Text="Larger"
                                                    Click="OnLarger" />
                                    <MenuFlyoutItem x:Name="TurnLeftItem" Text="Turn left"
                                                    Click="OnTurnLeft" />
                                    <MenuFlyoutItem x:Name="TurnRightItem" Text="Turn right"
                                                    Click="OnTurnRight" />
                                    <MenuFlyoutItem x:Name="ResetRotationItem" Text="Reset orientation"
                                                    Click="OnResetRotation" />
                                    <MenuFlyoutItem x:Name="ForwardItem" Text="Bring forward"
                                                    Click="OnBringForward" />
                                    <MenuFlyoutItem x:Name="BackwardItem" Text="Send backward"
                                                    Click="OnSendBackward" />
                                    <ToggleMenuFlyoutItem x:Name="LatchItem" Text="Hold to latch"
                                                          Click="OnLatchToggled" />
                                    <MenuFlyoutItem x:Name="ResetControlItem" Text="Reset control"
                                                    Click="OnResetControl" />
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Name="GroupsItem" Text="Whole groups"
                                                          Click="OnToggleEditGroup" />
                                    <ToggleMenuFlyoutItem x:Name="GridItem" Text="Grid"
                                                          Click="OnToggleGrid" />
                                    <ToggleMenuFlyoutItem x:Name="SnapItem" Text="Snapping"
                                                          Click="OnToggleSnap" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="LayoutsItem" Text="Layouts…"
                                                    Click="OnOpenProfiles" />
                                    <MenuFlyoutItem x:Name="ResetLayoutItem" Text="Reset layout"
                                                    Click="OnResetProfile" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="SaveButton" Click="OnSave" Content="&#xE73E;"
                                AutomationProperties.Name="Save"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Save (Ctrl+S)"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="DoneButton" Click="OnLeaveEditing" Content="&#xE711;"
                                AutomationProperties.Name="Done"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="Done" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>

        <!--
          The surface's own menu: the Android menu card, over a scrim, with the same
          sections in the same order — the controller, the layout, and the way out.
        -->
        <Grid x:Name="MenuLayer"
              Visibility="Collapsed"
              Background="{ThemeResource SystemControlPageBackgroundMediumAltMediumBrush}"
              Tapped="OnDismissMenu">
            <Border MaxWidth="460"
                    Margin="24"
                    Padding="24"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Tapped="OnSwallowTap"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Touch Gamepad"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <Button Click="OnCloseMenu" Content="&#xE711;"
                                    FontFamily="Segoe Fluent Icons"
                                    AutomationProperties.Name="Close the Touch Gamepad menu"
                                    HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="Controller"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="MenuController"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="MenuLinkDetail"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Layout"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MenuEdit" Grid.Column="0" Click="OnEnterEditing"
                                    Content="Edit" HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="MenuProfiles" Grid.Column="1" Click="OnOpenProfiles"
                                    HorizontalAlignment="Stretch" Content="Layouts" />
                        </Grid>
                        <Button x:Name="MenuUseDefault" Click="OnResetProfile"
                                HorizontalAlignment="Stretch"
                                Content="Use the default" />

                        <!--
                          The emulated controller itself, changed through the real
                          adapter lifecycle. Ports the Android Touch Gamepad menu,
                          where this replaced a Nintendo/Xbox face-layout toggle:
                          once the surface can present four genuine controllers the
                          letters follow the controller, and asking separately made
                          it possible to label a Joy-Con with an Xbox diamond.
                        -->
                        <TextBlock Text="Controller"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="MenuPersonality"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Controller"
                                  SelectionChanged="OnMenuPersonalityChanged" />
                        <!--
                          A consequence the dropdown cannot show, and one the user
                          would otherwise meet as a surprise.
                        -->
                        <TextBlock x:Name="MenuPersonalityNote"
                                   Text="Switching re-enumerates USB and loads that controller's own layout."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Display"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button x:Name="MenuFullScreen" Click="OnToggleFullScreen"
                                HorizontalAlignment="Stretch"
                                Content="Full screen (F11)" />

                        <Button x:Name="MenuExit" Click="OnClose"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Content="Exit Touch Gamepad" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
