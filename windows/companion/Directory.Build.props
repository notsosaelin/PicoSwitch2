<Project>

  <!--
    Repository-wide defaults for the PicoSwitch2 Windows companion.

    The two Core projects deliberately do NOT inherit a Windows target framework
    from here. WINDOWS_PASS.md §11.1 makes the absence of the Windows SDK the
    guard rather than a review convention: `net9.0` means a Windows API
    reference is a compile error, exactly as an Android import is a build
    failure in the Kotlin `:bridge-core` module.
  -->
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <!--
      The Windows SDK targeting version that makes newer WinRT types visible.
      NOT the minimum supported OS: that is SupportedOSPlatformVersion below,
      which matches WINDOWS_PASS.md §28.1. Anything called above that floor must
      be guarded by an ApiInformation / OperatingSystem.IsWindowsVersionAtLeast
      check.
    -->
    <PicoSwitchWindowsTargetFramework>net9.0-windows10.0.22621.0</PicoSwitchWindowsTargetFramework>
    <PicoSwitchSupportedOSPlatformVersion>10.0.22000.0</PicoSwitchSupportedOSPlatformVersion>
    <PicoSwitchPortableTargetFramework>net9.0</PicoSwitchPortableTargetFramework>

    <!-- Pinned deliberately; WINDOWS_PASS.md §32 R13 (WinUI 3 servicing churn). -->
    <PicoSwitchWindowsAppSdkVersion>1.7.250606001</PicoSwitchWindowsAppSdkVersion>
  </PropertyGroup>

</Project>
